#pragma max_recursion_depth 1
#pragma raytracing IrradianceBakeRayGen

#include "Includes/Common.hlsl"
#include "Includes/Random.hlsl"
#include "Includes/SkyModel.hlsl"
#include "Includes/PathTracer.hlsl"
#include "Includes/Geometry.hlsl"

// ── INPUTS ───────────────────────────────────────────────────────────────────
Texture2D<float4> _PositionMap;
Texture2D<float4> _NormalMap;

float3 _SunDirection;
float _BeamLux;
float _DiffuseLux;
float _DeltaHours;
uint _MaterialCount;
uint _FrameIndex;
uint _SamplesPerPixel;

RWTexture2D<float> _DoseMap;
RaytracingAccelerationStructure _SceneRTAS;

// Material and Geometry Buffers
StructuredBuffer<float4> _SimulationMaterials;
StructuredBuffer<float4> _GlobalVertices; 
StructuredBuffer<uint> _GlobalIndices;
StructuredBuffer<MeshMetadata> _MeshMetadata;

// ── RAY GENERATION ──────────────────────────────────────────────────────────
[shader("raygeneration")]
void IrradianceBakeRayGen()
{
    uint2 id = DispatchRaysIndex().xy;
    uint2 dims = DispatchRaysDimensions().xy;
    float4 bakedPos = _PositionMap[id];
    float4 bakedNormal = _NormalMap[id];
    
    if (bakedPos.w < 0.01 || length(bakedNormal.xyz) < 0.1) return;
    
    float3 origin = bakedPos.xyz;
    float3 normal = normalize(bakedNormal.xyz);
    float3 biasedOrigin = origin + normal * 0.02; // Standard launch bias
    
    uint baseSeed = Hash(id.y * dims.x + id.x + _FrameIndex);
    float totalIrradiance = 0.0;
    float nDotSun = dot(normal, _SunDirection);

    // 1. Direct Sun
    if (nDotSun > 0.0)
    {
        uint sunSeed = baseSeed;
        totalIrradiance += TracePath(biasedOrigin, _SunDirection, normal, sunSeed, true, _SceneRTAS, _SunDirection, _BeamLux, _DiffuseLux) * nDotSun;
    }

    // 2. Stochastic Multi-Sampling
    float indirectIrradiance = 0.0;
    uint numSamples = max(1, _SamplesPerPixel);
    for (uint i = 0; i < numSamples; i++)
    {
        uint sampleSeed = Hash(baseSeed + i);
        float3 randomDir = GetCosineWeightedDirection(normal, sampleSeed, PI);
        indirectIrradiance += TracePath(biasedOrigin, randomDir, normal, sampleSeed, false, _SceneRTAS, _SunDirection, _BeamLux, _DiffuseLux);
    }
    
    totalIrradiance += (indirectIrradiance / (float)numSamples) * PI;

    _DoseMap[id] += (totalIrradiance * _DeltaHours);
}

[shader("miss")]
void MissMain(inout Payload payload)
{
    payload.isOccluded = 0;
    payload.reflectance = 0.0;
    payload.transmittance = 0.0;
    payload.hitDistance = 0.0;
}

[shader("closesthit")]
void ClosestHitMain(inout Payload payload, in BuiltInTriangleIntersectionAttributes attribs)
{
    payload.isOccluded = 1;
    payload.hitDistance = RayTCurrent();
    uint instanceId = InstanceID();
    uint primId = PrimitiveIndex();
    uint geomId = 0; 
    #if __SHADER_TARGET__ >= 65
    geomId = GeometryIndex();
    #endif

    payload.worldNormal = ReconstructGeometricNormal(instanceId, primId, geomId, _GlobalVertices, _GlobalIndices, _MeshMetadata);
    
    payload.reflectance = 0.0;
    payload.transmittance = 0.0;
    if (instanceId < _MaterialCount)
    {
        float4 materialData = _SimulationMaterials[instanceId];
        payload.reflectance = saturate(materialData.x);
        payload.transmittance = saturate(materialData.y);
    }
}
