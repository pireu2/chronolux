#pragma max_recursion_depth 1
#pragma raytracing IrradianceBakeRayGen

Texture2D<float4> _PositionMap;
Texture2D<float4> _NormalMap;
float3 _SunDirection;
float _BeamLux;
float _DeltaHours;
float _MaterialCount;
RWTexture2D<float> _DoseMap;
RaytracingAccelerationStructure _SceneRTAS;
StructuredBuffer<float4> _SimulationMaterials;

struct Payload
{
    bool isOccluded;
    float reflectance;
    float transmittance;
};

[shader("raygeneration")]
void IrradianceBakeRayGen()
{
    uint2 id = DispatchRaysIndex().xy;
    float4 pos = _PositionMap[id];
    float4 nrm = _NormalMap[id];
    
    if (pos.w == 0.0 || length(nrm.xyz) < 0.1) return;
    
    float3 normal = normalize(nrm.xyz);
    float nDotL = dot(normal, _SunDirection);
    if (nDotL <= 0) return;

    RayDesc ray;
    ray.Origin = pos.xyz + normal * 0.002;
    ray.Direction = _SunDirection;
    ray.TMin = 0.001;
    ray.TMax = 100000.0;

    Payload payload;
    payload.isOccluded = true;
    payload.reflectance = 0.0;
    payload.transmittance = 0.0;
    
    // RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH (0x1) | RAY_FLAG_FORCE_OPAQUE (0x4)
    TraceRay(_SceneRTAS, 0x5, 0xFF, 0, 1, 0, ray, payload);
    
    float visibility = payload.isOccluded ? saturate(payload.transmittance) : 1.0;
    if (visibility > 0.0)
    {
        _DoseMap[id] += _BeamLux * nDotL * _DeltaHours * visibility;
    }
}

[shader("miss")]
void MissMain(inout Payload payload)
{
    payload.isOccluded = false;
    payload.reflectance = 0.0;
    payload.transmittance = 0.0;
}

[shader("closesthit")]
void ClosestHitMain(inout Payload payload, in BuiltInTriangleIntersectionAttributes attribs)
{
    payload.isOccluded = true;
    payload.reflectance = 0.0;
    payload.transmittance = 0.0;

    uint materialIndex = InstanceID();
    if ((float)materialIndex < _MaterialCount)
    {
        float4 materialData = _SimulationMaterials[materialIndex];
        payload.reflectance = saturate(materialData.x);
        payload.transmittance = saturate(materialData.y);
    }
}
