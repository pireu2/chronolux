<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project:/Assets/UI/Styles.uss" />
    
    <ui:VisualElement name="Root" class="root-container">
        
        <!-- Central Crosshair -->
        <ui:VisualElement name="Crosshair" class="crosshair" />
        
        <!-- ── VIEW 1: PROJECT LAUNCHER ── -->
        <ui:VisualElement name="LauncherScreen" class="launcher-screen">
            <ui:VisualElement class="launcher-card">
                <ui:VisualElement class="launcher-header">
                    <ui:Label text="CHRONOLUX: HERITAGE DOSIMETRY" class="title" style="font-size: 20px;" />
                    <ui:Label text="Professional Environmental Light Analysis Suite" style="color: #666; font-size: 11px; margin-top: -5px;" />
                </ui:VisualElement>
                <ui:VisualElement class="launcher-body">
                    <ui:VisualElement class="launcher-column">
                        <ui:Label text="LOAD RECENT PROJECT" class="module-title" />
                        <ui:ScrollView name="ProjectList" style="flex-grow: 1;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="column-divider" />
                    <ui:VisualElement class="launcher-column">
                        <ui:Label text="CREATE NEW PROJECT" class="module-title" />
                        <ui:TextField label="Project Name" name="InputProjectName" />
                        
                        <ui:Label text="Artifact Model (.obj)" style="margin-top: 15px; color: #666; font-size: 10px;" />
                        <ui:Label text="Select a single OBJ file to serve as the primary artifact." style="color: #444; font-size: 9px;" />
                        <ui:ScrollView name="ArtifactModelList" style="height: 100px; background-color: #1a1a1a; border-radius: 4px; margin-top: 5px;" />

                        <ui:Label text="Environment Models (.obj)" style="margin-top: 15px; color: #666; font-size: 10px;" />
                        <ui:Label text="Select multiple OBJ files to construct the environment." style="color: #444; font-size: 9px;" />
                        <ui:ScrollView name="EnvironmentModelList" style="height: 100px; background-color: #1a1a1a; border-radius: 4px; margin-top: 5px;" />

                        <ui:VisualElement style="flex-grow: 1;" />
                        <ui:Button text="INITIALIZE PROJECT" name="BtnLaunch" class="button button-primary" style="height: 45px; margin-top: 10px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ── VIEW 2: SIMULATION DASHBOARD ── -->
        <ui:VisualElement name="DashboardScreen" class="dashboard-screen" style="display: none; height: 100%;">
            
            <!-- Telemetry Header -->
            <ui:VisualElement class="header">
                <ui:Label text="CHRONOLUX" class="title" style="font-size: 20px;" />
                <ui:VisualElement style="flex-direction: row; align-items: center;">
                    <ui:Label text="2025-06-21 12:00" name="TxtTime" style="margin-right: 25px; font-size: 16px; -unity-font-style: bold;" />
                    <ui:Label text="ALT: 0.0° | AZI: 0.0°" name="TxtSunCoords" style="color: #666; margin-right: 25px; font-size: 13px;" />
                    <ui:Button text="EXPORT CSV" name="BtnExport" class="button" style="height: 32px; width: 100px; margin-right: 10px; background-color: #552200;" />
                    <ui:Button text="NAVIGATE" name="BtnNav" class="button button-primary" style="height: 32px; width: 100px; margin-right: 10px;" />
                    <ui:Button text="EXIT" name="BtnExit" class="button" style="height: 32px; width: 60px;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Workspace Sidebars -->
            <ui:VisualElement style="flex-grow: 1; flex-direction: row; pointer-events: none;">
                
                <!-- Left Sidebar: Controls -->
                <ui:VisualElement class="sidebar" style="pointer-events: auto;">
                    
                    <ui:VisualElement class="module-card">
                        <ui:Label text="LOCATION" class="module-title" />
                        <ui:TextField label="Lat" name="InLat" value="44.426" />
                        <ui:TextField label="Lon" name="InLon" value="26.102" />
                    </ui:VisualElement>

                    <ui:VisualElement class="module-card">
                        <ui:Label text="TIME RANGE" class="module-title" />
                        <ui:TextField label="Year" name="InYear" value="2025" />
                        <ui:TextField label="Start" name="InStartDay" value="1" />
                        <ui:TextField label="End" name="InEndDay" value="365" />
                    </ui:VisualElement>

                    <ui:VisualElement class="module-card">
                        <ui:Label text="SIMULATION ENGINE" class="module-title" />
                        
                        <ui:DropdownField label="Resolution" name="DdRes" index="1" />

                        <ui:VisualElement style="flex-direction: row; align-items: center; margin-top: 5px;">
                            <ui:SliderInt label="SPP" name="SldSamples" low-value="1" high-value="64" value="8" style="flex-grow: 1;" />
                            <ui:Label text="8" name="LblSamplesVal" style="width: 25px; -unity-text-align: middle-right; font-size: 10px;" />
                        </ui:VisualElement>
                        <ui:VisualElement style="height: 10px;" />
                        <ui:Button text="START BAKE" name="BtnStart" class="button" style="background-color: #004D40;" />
                        <ui:Button text="STOP" name="BtnStop" class="button" />
                        <ui:Button text="CLEAR MAP" name="BtnClear" class="button" />
                        <ui:ProgressBar name="ProgSim" style="margin-top: 15px;" />
                        
                        <ui:Label text="DAMAGE HISTORY" style="font-size: 9px; color: #555; margin-top: 10px;" />
                        <ui:SliderInt label="Day Preview" name="SldHistory" low-value="-1" high-value="0" value="-1" />
                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- Center Spacing -->
                <ui:VisualElement style="flex-grow: 1; pointer-events: none;" />

                <!-- Right Sidebar: Data -->
                <ui:ScrollView class="sidebar sidebar-right" style="pointer-events: auto;">
                    
                    <ui:VisualElement class="module-card">
                        <ui:Label text="GLOBAL METROLOGY" class="module-title" />
                        <ui:Label text="PEAK DOSE" class="telemetry-label" />
                        <ui:Label text="0 Lux·h" name="TxtMaxDose" class="value-hero" />
                    </ui:VisualElement>

                    <!-- SELECTION PANEL -->
                    <ui:VisualElement name="SelectionPanel" class="module-card" style="display: none;">
                        <ui:Label text="OBJECT PROPERTIES" class="module-title" />
                        <ui:Label text="Object Name" name="TxtSelectedName" style="color: #666; font-size: 9px; margin-bottom: 12px;" />
                        
                        <!-- TRANSFORM SECTION -->
                        <ui:VisualElement name="TransformControls" style="display: none; margin-bottom: 12px; padding-bottom: 12px; border-bottom-width: 1px; border-bottom-color: #333;">
                            <ui:Label text="TRANSFORM" style="color: #888; font-size: 8px; margin-bottom: 6px; -unity-font-style: bold;" />
                            
                            <ui:TextField label="X" name="InPosX" value="0.0" />
                            <ui:TextField label="Y" name="InPosY" value="0.0" />
                            <ui:TextField label="Z" name="InPosZ" value="0.0" />
                            <ui:TextField label="Scale" name="InScale" value="1.0" style="margin-top: 4px;" />
                        </ui:VisualElement>

                        <ui:VisualElement name="MaterialControls">
                            <ui:Label text="SIMULATION PARAMETERS" style="color: #888; font-size: 8px; margin-bottom: 6px; -unity-font-style: bold;" />
                            
                            <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 4px;">
                                <ui:Slider label="Refl" name="SldRefl" low-value="0" high-value="1" style="flex-grow: 1;" />
                                <ui:Label text="0.00" name="LblReflVal" style="width: 35px; font-size: 10px; -unity-text-align: middle-right; color: #00E5FF;" />
                            </ui:VisualElement>
                            
                            <ui:VisualElement style="flex-direction: row; align-items: center;">
                                <ui:Slider label="Trans" name="SldTrans" low-value="0" high-value="1" style="flex-grow: 1;" />
                                <ui:Label text="0.00" name="LblTransVal" style="width: 35px; font-size: 10px; -unity-text-align: middle-right; color: #00E5FF;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="module-card">
                        <ui:Label text="SCIENTIFIC ANALYTICS" class="module-title" />
                        
                        <ui:VisualElement class="stat-row">
                            <ui:Label text="Metrology Error" class="stat-label" />
                            <ui:Label text="0.00%" name="TxtErrorPct" class="stat-value" style="color: #00E5FF;" />
                        </ui:VisualElement>

                        <ui:VisualElement class="stat-row">
                            <ui:Label text="Risk Level" class="stat-label" />
                            <ui:Label text="LOW" name="TxtRisk" class="stat-value" style="color: #4CAF50;" />
                        </ui:VisualElement>

                        <ui:Label text="IRRADIANCE HISTORY (W/m²)" style="font-size: 9px; color: #555; margin-top: 15px;" />
                        <ui:VisualElement name="GraphContainer" class="graph-container" />
                    </ui:VisualElement>

                </ui:ScrollView>

            </ui:VisualElement>

            <!-- Material Ribbon -->
            <ui:VisualElement class="bottom-bar">
                <ui:Label text="MATERIAL LIBRARY" class="module-title" style="width: 120px;" />
                <ui:ScrollView name="MaterialCatalog" orientation="Horizontal" style="flex-grow: 1;" />
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- ── VIEW 3: LOADING OVERLAY ── -->
        <ui:VisualElement name="LoadingScreen" style="position: absolute; width: 100%; height: 100%; background-color: rgba(0,0,0,0.85); display: none; align-items: center; justify-content: center;">
            <ui:VisualElement style="width: 400px; padding: 30px; background-color: #1e1e1e; border-radius: 8px; border-width: 1px; border-color: #00E5FF;">
                <ui:Label text="LOADING ASSETS..." style="color: white; font-size: 18px; -unity-font-style: bold; margin-bottom: 20px; -unity-text-align: middle-center;" />
                <ui:Label name="TxtLoadingStatus" text="Initializing parser..." style="color: #666; font-size: 11px; margin-bottom: 5px;" />
                <ui:ProgressBar name="ProgLoading" value="0" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
