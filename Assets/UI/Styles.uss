/* ChronoLux Professional Stylesheet */

:root {
    --bg-dark: #1E1E1E;
    --bg-glass: rgba(30, 30, 30, 0.9);
    --panel-dark: #252526;
    --panel-light: #2D2D30;
    --border-grey: #3F3F3F;
    --text-white: #CCCCCC;
    --text-dim: #888888;
    --text-dark: #111111; 
    --cyan-accent: #00E5FF;
}

.root-container {
    flex-grow: 1;
    color: var(--text-white);
}

/* ── INPUTS ─────────────────────────────────────────────────────────── */
.unity-base-field__label {
    min-width: 80px;
    color: var(--text-dim);
    font-size: 11px;
}

.unity-text-field__input {
    background-color: #666;
    color: white;
    -unity-font-style: bold;
    padding: 3px 6px;
    border-radius: 3px;
    border-width: 0;
}

.unity-text-field__input:focus {
    background-color: #888;
}

/* ── SHARED ─────────────────────────────────────────────────────────── */
.panel {
    background-color: var(--panel-dark);
    border-color: var(--border-grey);
    border-width: 1px;
    border-radius: 6px;
}

.button {
    background-color: #3F3F3F;
    border-radius: 4px;
    padding: 8px;
    margin: 3px 0;
    color: white;
    -unity-font-style: bold;
    font-size: 12px;
}

.button:hover {
    background-color: var(--cyan-accent);
    color: black;
}

.button-primary {
    background-color: #00838F;
}

/* ── LAUNCHER HUB ────────────────────────────────────────────────────── */
.launcher-screen {
    flex-grow: 1;
    background-color: var(--bg-dark);
    justify-content: center;
    align-items: center;
}

.launcher-card {
    width: 850px;
    height: 600px;
    background-color: var(--panel-dark);
    border-width: 1px;
    border-color: #333;
    border-radius: 12px;
    overflow: hidden;
    border-bottom-width: 4px;
    border-bottom-color: #111;
}

.launcher-header {
    height: 80px;
    background-color: #1a1a1a;
    justify-content: center;
    padding-left: 30px;
    border-bottom-width: 1px;
    border-bottom-color: var(--cyan-accent);
}

.launcher-body {
    flex-grow: 1;
    flex-direction: row;
}

.launcher-column {
    flex-grow: 1;
    flex-basis: 0;
    padding: 25px;
}

.column-divider {
    width: 1px;
    background-color: #333;
    margin: 40px 0;
}

.list-item {
    background-color: #2d2d2d;
    padding: 10px 15px;
    margin-bottom: 5px;
    border-radius: 4px;
    border-left-width: 3px;
    border-left-color: transparent;
}

.list-item:hover {
    background-color: #444;
    border-left-color: var(--cyan-accent);
}

/* ── DASHBOARD HUD ───────────────────────────────────────────────────── */
.dashboard-screen {
    flex-grow: 1;
}

.header {
    height: 50px;
    flex-direction: row;
    background-color: #111;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px;
    border-bottom-width: 1px;
    border-bottom-color: var(--cyan-accent);
}

.sidebar {
    width: 300px;
    background-color: var(--bg-glass);
    border-width: 0;
    margin: 0;
    padding: 15px;
    border-right-width: 1px;
    border-right-color: #333;
}

.sidebar-right {
    border-right-width: 0;
    border-left-width: 1px;
    border-left-color: #333;
}

/* Sub-grouping cards within sidebars */
.module-card {
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 4px;
    padding: 12px;
    margin-bottom: 15px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
}

.module-title {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--text-dim);
    margin-bottom: 8px;
    letter-spacing: 1px;
}

/* Hero Data Presentation */
.value-hero {
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--cyan-accent);
    margin: 5px 0;
}

.telemetry-label {
    font-size: 12px;
    color: #888;
}

/* Material Catalog swatches */
.bottom-bar {
    height: 120px;
    background-color: var(--bg-glass);
    border-top-width: 1px;
    border-top-color: var(--cyan-accent);
    padding: 15px;
}

#MaterialCatalog .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
}
